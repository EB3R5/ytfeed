#!/bin/zsh
# Regenerate the ER diagram in README.md from the SQLAlchemy models.
# Run after changing ytfeed/db/models.py:  scripts/update-erd
set -e

ROOT="$(cd "$(dirname "${0:A}")/.." && pwd)"
cd "$ROOT"

exec .venv/bin/python - <<'PY'
import re

from ytfeed.db.models import Base

START = "<!-- ERD:START (generated by scripts/update-erd — do not edit by hand) -->"
END = "<!-- ERD:END -->"


def type_token(col) -> str:
    # mermaid attribute types: no spaces or commas
    return str(col.type).lower().replace(", ", "-").replace(" ", "_")


lines = ["```mermaid", "erDiagram"]
relationships = []
tables = sorted(Base.metadata.tables.values(), key=lambda t: t.name)
for table in tables:
    lines.append(f"  {table.name} {{")
    for col in table.columns:
        marks = []
        if col.primary_key:
            marks.append("PK")
        if col.foreign_keys:
            marks.append("FK")
        if col.unique:
            marks.append("UK")
        suffix = " " + ", ".join(marks) if marks else ""
        lines.append(f"    {type_token(col)} {col.name}{suffix}")
    lines.append("  }")
    for col in table.columns:
        for fk in col.foreign_keys:
            left = "|o" if col.nullable else "||"
            relationships.append(
                f'  {fk.column.table.name} {left}--o{{ {table.name} : "{col.name}"'
            )
lines += relationships
lines.append("```")
section = f"{START}\n" + "\n".join(lines) + f"\n{END}"

with open("README.md") as f:
    readme = f.read()

if START in readme:
    readme = re.sub(
        re.escape(START) + r".*?" + re.escape(END), section, readme, flags=re.S
    )
else:
    block = (
        "## Schema\n\n"
        "Generated from `ytfeed/db/models.py` — refresh with `scripts/update-erd`.\n\n"
        f"{section}\n\n"
    )
    anchor = "## Engineering notes"
    if anchor in readme:
        readme = readme.replace(anchor, block + anchor)
    else:
        readme = readme.rstrip() + "\n\n" + block

with open("README.md", "w") as f:
    f.write(readme)
print(f"README.md updated: {len(tables)} tables, {len(relationships)} relationships")
PY
