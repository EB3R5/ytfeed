# Copy to .env (gitignored). Read by compose.yml only; the app itself uses config.toml.

# Folder in your Obsidian vault that transcripts are written to (host path).
YTFEED_VAULT=~/Documents/Vault/raw

# Port on 127.0.0.1 the web UI is published on.
YTFEED_PORT=8040

# Your uid/gid (`id -u`, `id -g`) so files the container writes are yours.
YTFEED_UID=1000
YTFEED_GID=1000

# Where `notebooklm login` stored its profile.
NOTEBOOKLM_DIR=~/.notebooklm
